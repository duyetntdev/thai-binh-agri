APP_NAME="Thai Binh Agriculture Commerce"
APP_ENV=local
APP_KEY=base64:Z0U7Mqm2zy9r2q/vlrfkN+d/XB7FPENGdsBweMstUH0=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (matches docker-compose mysql service) ───────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=thai_binh_agri
DB_USERNAME=laravel
DB_PASSWORD=secret

# ── Cache & Session via Redis ─────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Mail (log only for local testing) ────────────────────────────────────────
MAIL_MAILER=log

# ── VNPay sandbox ─────────────────────────────────────────────────────────────
VNPAY_MERCHANT_ID=
VNPAY_SECRET_KEY=
VNPAY_MERCHANT_ID_HASH=
VNPAY_URL=https://sandbox.vnpayment.vn/paygate
VNPAY_RETURN_URL=http://localhost:8000/payment/callback
